{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.invalid/firstbrain/nary-transform.preview.v1.schema.json",
  "title":"First Brain generic typed n-ary transform preview (isolated candidate)",
  "type":"object",
  "additionalProperties":false,
  "required":["status","decision","packet"],
  "properties":{
    "status":{"const":"candidate_only"},
    "decision":{"const":"HOLD"},
    "packet":{
      "type":"object","additionalProperties":false,
      "required":["schema","kind","id","rule","typed_result","input_refs","content_hash","authority","evidence_certification","memory_approval","real_ack","semantic_claim","provenance_scope","lossiness"],
      "properties":{
        "schema":{"const":"firstbrain.nary-transform.preview.v1"},
        "kind":{"const":"transformed"},
        "id":{"type":"string","pattern":"^cmp:[a-f0-9]{64}$"},
        "rule":{
          "type":"object","additionalProperties":false,"required":["name","version","context"],
          "properties":{
            "name":{"enum":["quantity_sum","quantity_mean","quantity_ratio","data_rate","record_project"]},
            "version":{"type":"string","minLength":1,"maxLength":128},
            "context":{"type":"object"}
          }
        },
        "typed_result":{
          "oneOf":[
            {"type":"object","additionalProperties":false,"required":["kind","dimension","unit","value"],"properties":{
              "kind":{"const":"quantity_result"},"dimension":{"enum":["data","duration","ratio","data_rate"]},
              "unit":{"enum":["bit","B","kB","MB","KiB","MiB","ms","s","min","h","1","bit/s"]},
              "value":{"type":"object","additionalProperties":false,"required":["numerator","denominator"],"properties":{
                "numerator":{"type":"string","pattern":"^-?(0|[1-9][0-9]*)$"},
                "denominator":{"type":"string","pattern":"^[1-9][0-9]*$"}
              }}
            }},
            {"type":"object","additionalProperties":false,"required":["kind","lossy","rows"],"properties":{
              "kind":{"const":"selected_records"},"lossy":{"const":true},
              "rows":{"type":"array","minItems":2,"maxItems":32,"items":{"type":"object","required":["position","fields"],"additionalProperties":false,"properties":{
                "position":{"type":"integer","minimum":0,"maximum":31},"fields":{"type":"object"}
              }}}
            }}
          ]
        },
        "input_refs":{"type":"array","minItems":2,"maxItems":32,"items":{
          "type":"object","additionalProperties":false,"required":["id","fingerprint","revision"],"properties":{
            "id":{"type":"string"},"fingerprint":{"type":"string","minLength":1},"revision":{"type":["string","null"]}
          }}},
        "content_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "authority":{"const":"none"},
        "evidence_certification":{"const":"UNVERIFIED"},
        "memory_approval":{"const":"NOT_APPROVED"},
        "real_ack":{"const":"NOT_VERIFIED"},
        "semantic_claim":{"const":"NOT_EVALUATED"},
        "provenance_scope":{"const":"ISOLATED_CALLER_DECLARED_ONLY"},
        "lossiness":{"enum":["FIELDS_OMITTED","NONE_FOR_DECLARED_NUMERIC_INPUTS"]}
      }
    }
  }
}