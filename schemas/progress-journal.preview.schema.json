{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/firstbrain/progress-journal.preview.v0.1.schema.json",
  "title": "First Brain planned/actual/delayed per-project stream journal (isolated)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "decision",
    "authority",
    "identity_verified",
    "review_approved",
    "schema",
    "journal_id",
    "project_id",
    "proof_id",
    "event_id",
    "sector",
    "stream",
    "proof_revision",
    "expected_start",
    "expected_due",
    "plan_ref",
    "revision",
    "expected_progress_percent",
    "actual_progress_percent",
    "progress_status",
    "last_observed_on",
    "forecast_due",
    "delay_reason_code",
    "next_action_code",
    "days_shifted",
    "days_overdue",
    "progress_variance_percent",
    "completed_on",
    "evidence_ref",
    "snapshot_stale",
    "entries",
    "history_head_hash",
    "persistence",
    "notification"
  ],
  "properties": {
    "status": {
      "const": "candidate_only"
    },
    "decision": {
      "const": "HOLD"
    },
    "authority": {
      "const": "none"
    },
    "identity_verified": {
      "const": false
    },
    "review_approved": {
      "const": false
    },
    "schema": {
      "const": "firstbrain.project-progress.candidate.v0.1"
    },
    "journal_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
    },
    "proof_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
    },
    "sector": {
      "enum": [
        "ENGINEERING",
        "INFRASTRUCTURE",
        "DATA",
        "WATER",
        "ELECTRICITY"
      ]
    },
    "stream": {
      "enum": [
        "AUTOMATION",
        "REASONING_SUMMARY",
        "WORLD_MODEL",
        "MEMORY"
      ]
    },
    "proof_revision": {
      "type": "integer",
      "minimum": 1
    },
    "expected_start": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "expected_due": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "plan_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "expected_progress_percent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "actual_progress_percent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "progress_status": {
      "enum": [
        "PLANNED",
        "IN_PROGRESS",
        "DELAYED",
        "BLOCKED",
        "COMPLETED"
      ]
    },
    "last_observed_on": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "forecast_due": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "delay_reason_code": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,59}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "next_action_code": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,59}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "days_shifted": {
      "type": "integer"
    },
    "days_overdue": {
      "type": "integer",
      "minimum": 0
    },
    "progress_variance_percent": {
      "type": "integer",
      "minimum": -100,
      "maximum": 100
    },
    "completed_on": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
    },
    "snapshot_stale": {
      "type": "boolean"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "journal_id",
          "sequence",
          "kind",
          "details",
          "prev_hash",
          "hash"
        ],
        "additionalProperties": false,
        "properties": {
          "journal_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "PLAN_REGISTERED",
              "PROGRESS_OBSERVATION"
            ]
          },
          "details": {
            "type": "object"
          },
          "prev_hash": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "history_head_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "persistence": {
      "const": "IN_MEMORY_ONLY"
    },
    "notification": {
      "const": "NOT_SENT"
    }
  }
}
