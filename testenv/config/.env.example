# testenv 設定範本 — 僅金鑰「名稱」與本地合成值說明。勿填入真實 production 密鑰。
# 複製為 config/testenv.env 後由 start.sh 載入（可選）。

# --- 本地迴路（免費、合成）---
TESTENV_HOST=127.0.0.1
TESTENV_PORT=18765
TESTENV_DATA_DIR=./loop/data
TESTENV_EXECUTOR_MODE=MOCK
TESTENV_ORIGIN_ID=origin-local
TESTENV_WORKER_ID=worker-mock
TESTENV_ORIGIN_SECRET=testenv-origin-secret-32bytes-min!!
TESTENV_WORKER_SECRET=testenv-worker-secret-32bytes-min!!
TESTENV_COST_CAP_USD=0.05
TESTENV_MAX_ATTEMPTS=3
TESTENV_LEASE_SECONDS=30

